{
  "name": "@springbrand/dsh-plugin-marketplace",
  "version": "1.0.5",
  "description": "A visual plugin marketplace for DeepSeek Harness profiles.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springbrand-lab/dsh-plugin-market.git"
  },
  "homepage": "https://github.com/springbrand-lab/dsh-plugin-market",
  "keywords": ["deepseek", "dsh", "plugin", "marketplace"],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && tsdown",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0-0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bugs": {
    "url": "https://github.com/springbrand-lab/dsh-plugin-market/issues"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "client", "assets", "cordis.patch.yml", "LICENSE", "README.md", "README.zh.md"],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "lucide-react": "1.31.0",
    "react": "^18.3.1",
    "tsdown": "^0.15.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
